# Copy to k8s/.env (git-ignored) and fill in by hand; kustomize turns it into the Secret
# `worker-env`, loaded into the worker. Values from the team password manager.

# The one OpenAI-compatible LLM endpoint (pipeline/common/llm.py).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Retrieval (D7, D8, D15)
GEMINI_API_KEY=
GOOGLE_FACTCHECK_API_KEY=
OXYLABS_USERNAME=
OXYLABS_PASSWORD=
