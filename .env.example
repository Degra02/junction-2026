# Copy to .env (git-ignored; mise loads it automatically). Real values live in the team password manager.
# Rotate every key after the event: the repo is published under MIT.

# The pipeline's one OpenAI-compatible LLM endpoint (pipeline/common/llm.py); switching provider
# means changing these three.
#   Hostinger AI Router (D12): https://router.hostinger.com/v1  (keys start sk-hstgr-)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Retrieval (D7, D8, D15)
GEMINI_API_KEY=
GOOGLE_FACTCHECK_API_KEY=
OXYLABS_USERNAME=
OXYLABS_PASSWORD=

# API settings are optional; names and defaults are in api/src/config.rs. For eval runs
# against a local API:
#   RATE_LIMIT_PER_MINUTE=0
#   MAX_ANALYSES_PER_HOUR=0
#   MAX_CONCURRENT_ANALYSES=8
#   MAX_CONCURRENT_INFERENCE=4
