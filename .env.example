# Copy to .env (git-ignored; mise loads it automatically). Real values live in the team password manager.
# Rotate every key after the event: the repo is published under MIT.

# Default OpenAI-compatible model endpoint used by the app; switch provider by changing these three.
#   Hostinger AI Router (default, Hostinger challenge): https://router.hostinger.com/v1  (keys start sk-hstgr-)
#   Verda:       https://inference.verda.com/v1
#   NVIDIA NIM:  https://integrate.api.nvidia.com/v1
#   OpenAI:      https://api.openai.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Provider keys
OPENAI_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
FEATHERLESS_API_KEY=
VERDA_API_KEY=

# Data / retrieval
EXA_API_KEY=
CONTEXT_DEV_API_KEY=
CALA_API_KEY=
CLOUDINARY_URL=
DATABASE_URL=
