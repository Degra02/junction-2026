{
  "openapi": "3.1.0",
  "info": {
    "title": "Junction 2026 propaganda analysis API",
    "description": "Submit text or an article URL, follow progress over SSE, read the evidence-backed scores. Stage patch schemas describe the internal worker API (`POST /stages/{name}`).",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/analyses": {
      "post": {
        "tags": [
          "analyses"
        ],
        "summary": "Start an analysis of pasted text or an article URL.",
        "description": "Returns at once; follow progress on `/api/analyses/{id}/events`. Re-submitting the same input\nreturns the earlier analysis (`cached: true`) unless that one failed, had a failed step, or\n`force=true` is set. Only new analyses count towards the rate limits.",
        "operationId": "create",
        "parameters": [
          {
            "name": "force",
            "in": "query",
            "description": "Run again even when an earlier analysis of the same input could be reused.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Input"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Analysis queued or reused",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Created"
                }
              }
            }
          },
          "422": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited (`rate_limited` per client, `busy` service-wide)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/analyses/{id}": {
      "get": {
        "tags": [
          "analyses"
        ],
        "summary": "Read an analysis: progress while running, the full result once done.",
        "operationId": "get_one",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Analysis ID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Analysis"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/analyses/{id}/events": {
      "get": {
        "tags": [
          "analyses"
        ],
        "summary": "Server-sent progress events.",
        "description": "Starts with a `snapshot` of the record, then `queue` and `step` events, and ends with `done`.\nA finished analysis sends `snapshot` and `done` at once, or with `replay=true` plays its\nstored steps back from an empty snapshot (a demo that does not depend on live sources).\nClients that fall behind are disconnected and get a fresh snapshot when `EventSource`\nreconnects. Payloads are `AnalysisEvent`.",
        "operationId": "events",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Analysis ID",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "replay",
            "in": "query",
            "description": "For a finished analysis: send its steps again with short pauses, as if it ran now.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stream of `AnalysisEvent`",
            "content": {
              "text/event-stream": {}
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/analyses/{id}/rerun": {
      "post": {
        "tags": [
          "analyses"
        ],
        "summary": "Run a finished analysis again from one stage on.",
        "description": "Creates a new analysis that keeps the stored output of the stages before `from` and runs\n`from` and everything after it (both signal stages when `from` is either of them). Use it to\nretry a stage that failed, or to score the same retrieved context again after a change to\nthe signals, the combiner or the explanation. The new analysis replaces the source as the\ncached result of its input.",
        "operationId": "rerun",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Analysis to start from",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "First stage to run again.",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/StageName"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "New analysis queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Created"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "The source analysis has not finished",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Unknown stage",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/graph": {
      "get": {
        "tags": [
          "sources"
        ],
        "summary": "The source graph: outlets tied by shared analytics IDs, copied text, translations and links.",
        "description": "Built offline from stored analyses (`mise run graph:build`). The shape is owned by\n`pipeline/graph/build.py`; the API serves the file unchanged. A tie is evidence of a\nrelationship between two sites, not a judgement of either.",
        "operationId": "graph",
        "responses": {
          "200": {
            "description": "Outlets, ties with their evidence, clusters",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "No source graph published yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "API, database and worker status.",
        "description": "200 while the API and its database work, even if the worker is down (`worker: null`), so a\nworker restart does not take the API out of the load balancer.",
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/metrics": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Evaluation metrics for the metrics page, as written by the eval harness (`evals/`).",
        "description": "The shape is owned by the eval harness; the API serves the file unchanged.",
        "operationId": "metrics",
        "responses": {
          "200": {
            "description": "Eval harness output",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "No metrics published yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/stats": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Usage and latency over every stored analysis.",
        "description": "Feeds the \"scale\" part of the metrics page: how many analyses ran, how often the cache\nanswered, and how long each stage takes on this machine.",
        "operationId": "stats",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stats"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Analysis": {
        "type": "object",
        "description": "One analysis of one piece of content. Every stage reads it and returns a patch.",
        "required": [
          "id",
          "schema_version",
          "pipeline_version",
          "created_at",
          "updated_at",
          "status",
          "steps",
          "input",
          "claims",
          "queries",
          "context",
          "sources",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "schema_version": {
            "type": "integer",
            "format": "int32",
            "description": "[`crate::SCHEMA_VERSION`] at creation time.",
            "minimum": 0
          },
          "pipeline_version": {
            "type": "string",
            "description": "Build or model-set identifier; part of the cache key, so a new pipeline re-analyses."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "$ref": "#/components/schemas/AnalysisStatus"
          },
          "queue_position": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Place in the queue (1 = next to start) while `status` is `queued`; null otherwise.",
            "minimum": 0
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why the analysis failed, in plain language. Set only when `status` is `failed`."
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Step"
            },
            "description": "One entry per pipeline stage, in execution order."
          },
          "input": {
            "$ref": "#/components/schemas/Input"
          },
          "language": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Language",
                "description": "Detected language of the input and how well the pipeline supports it (D2). Set by `extract`."
              },
              {
                "type": "null"
              }
            ]
          },
          "document": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Document",
                "description": "Cleaned content of the input. Set by `extract`."
              },
              {
                "type": "null"
              }
            ]
          },
          "topic": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Topic",
                "description": "What the item is about. Set by `understand`."
              },
              {
                "type": "null"
              }
            ]
          },
          "claims": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Claim"
            },
            "description": "Key claims, each traceable to a verbatim span of the document. Set by `understand`."
          },
          "queries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchQuery"
            },
            "description": "Search queries in the item's language and in English. Set by `understand`."
          },
          "context": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContextItem"
            },
            "description": "Related items found online. Set by `retrieve`; `story` fills the story fields."
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceProfile"
            },
            "description": "What is known about the outlets behind the document and the context items, one entry\nper domain. Set by `retrieve`."
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "description": "Signals with their evidence. Appended by `signals_single` and `signals_coordinated`."
          },
          "scores": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Scores",
                "description": "Confidence per dimension. Set by `score`."
              },
              {
                "type": "null"
              }
            ]
          },
          "explanation": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Explanation",
                "description": "Plain-language reasons, each tied to evidence. Set by `explain`."
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "AnalysisEvent": {
        "oneOf": [
          {
            "type": "object",
            "title": "SnapshotEvent",
            "required": [
              "analysis",
              "type"
            ],
            "properties": {
              "analysis": {
                "$ref": "#/components/schemas/Analysis"
              },
              "type": {
                "type": "string",
                "enum": [
                  "snapshot"
                ]
              }
            }
          },
          {
            "type": "object",
            "title": "QueueEvent",
            "description": "New place in the queue; 1 = next to start.",
            "required": [
              "position",
              "type"
            ],
            "properties": {
              "position": {
                "type": "integer",
                "format": "int32",
                "minimum": 0
              },
              "type": {
                "type": "string",
                "enum": [
                  "queue"
                ]
              }
            }
          },
          {
            "type": "object",
            "title": "StepEvent",
            "required": [
              "step",
              "type"
            ],
            "properties": {
              "step": {
                "$ref": "#/components/schemas/Step"
              },
              "type": {
                "type": "string",
                "enum": [
                  "step"
                ]
              }
            }
          },
          {
            "type": "object",
            "title": "DoneEvent",
            "required": [
              "analysis",
              "type"
            ],
            "properties": {
              "analysis": {
                "$ref": "#/components/schemas/Analysis"
              },
              "type": {
                "type": "string",
                "enum": [
                  "done"
                ]
              }
            }
          }
        ],
        "description": "Payload of the server-sent events on `GET /api/analyses/{id}/events`.\n\nThe SSE event name equals `type`. The stream starts with `snapshot`, sends `queue` while the\nanalysis waits its turn and `step` on every step change (a running step repeats with a new\n`detail` as the stage reports progress), and ends with `done` (also sent for failed analyses)."
      },
      "AnalysisStatus": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "done",
          "failed"
        ]
      },
      "Claim": {
        "type": "object",
        "required": [
          "id",
          "text",
          "span"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique within the analysis, e.g. `cl1`."
          },
          "text": {
            "type": "string",
            "description": "Must equal the document text at `span`, otherwise the claim is dropped."
          },
          "span": {
            "$ref": "#/components/schemas/Span"
          }
        }
      },
      "ContextItem": {
        "type": "object",
        "required": [
          "id",
          "url",
          "text",
          "retrieved_by",
          "tracking_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique within the analysis, e.g. `ctx1`."
          },
          "url": {
            "type": "string"
          },
          "outlet": {
            "type": [
              "string",
              "null"
            ]
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": "string",
            "description": "Extracted body text; quotes in evidence must be substrings of it. For a fact-check: the\nreviewed claim followed by the verdict text."
          },
          "language": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 639-1 code."
          },
          "retrieved_by": {
            "type": "string",
            "description": "Adapter that found it, e.g. `google_news`, `gdelt`, `fact_check_api`, `oxylabs`."
          },
          "tracking_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Analytics and ad IDs found in the page (GA, GTM, `AdSense`); compared across outlets by\nthe infrastructure signal. Empty when the page was not fetched."
          },
          "fact_check": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/FactCheck",
                "description": "Set when the item is a fact-check (`ClaimReview`) rather than coverage of the event."
              },
              {
                "type": "null"
              }
            ]
          },
          "similarity": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Similarity to the analysed item. Set by `story`."
          },
          "in_story": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Whether it covers the same event. Set by `story`."
          },
          "story_reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why it was kept or dropped from the story. Set by `story`."
          }
        }
      },
      "Contribution": {
        "type": "object",
        "required": [
          "family",
          "contribution",
          "evidence_ids"
        ],
        "properties": {
          "family": {
            "$ref": "#/components/schemas/Family"
          },
          "contribution": {
            "type": "number",
            "format": "double",
            "description": "Log-odds contribution of the family (combiner coefficient × value)."
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Created": {
        "type": "object",
        "description": "Response of `POST /api/analyses`.",
        "required": [
          "id",
          "cached"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "cached": {
            "type": "boolean",
            "description": "True when an earlier analysis of the same input and pipeline version was reused."
          }
        }
      },
      "Document": {
        "type": "object",
        "required": [
          "paragraphs",
          "outbound_links",
          "tracking_ids"
        ],
        "properties": {
          "url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Source URL when the input was a URL."
          },
          "outlet": {
            "type": [
              "string",
              "null"
            ],
            "description": "Outlet domain, e.g. `example.com`."
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "author": {
            "type": [
              "string",
              "null"
            ]
          },
          "paragraphs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Body paragraphs; spans index into these."
          },
          "outbound_links": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tracking_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Analytics and ad IDs found in the page (GA, GTM, `AdSense`), e.g. `UA-12345-1`."
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "Error body of every non-2xx JSON response.",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Stable machine-readable code, e.g. `invalid_input`, `not_found`, `rate_limited`."
          },
          "message": {
            "type": "string",
            "description": "Human-readable explanation."
          }
        }
      },
      "Evidence": {
        "type": "object",
        "required": [
          "id",
          "family",
          "signal",
          "value",
          "detail",
          "source_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique within the analysis. Use a stage prefix (`s1`, `c1`) to avoid clashes."
          },
          "family": {
            "$ref": "#/components/schemas/Family"
          },
          "signal": {
            "type": "string",
            "description": "Signal name inside the family, e.g. `manipulative_wording`, `copied_passages`; the\nmapping to a score strength is in `pipeline/score/families.py`."
          },
          "value": {
            "type": "number",
            "format": "double",
            "description": "Signal value; scale is defined per signal and documented by its owner."
          },
          "detail": {
            "type": "string",
            "description": "One plain-language sentence for the UI."
          },
          "source_refs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceRef"
            },
            "description": "Where the evidence comes from: at least one. Items without a source, or with a dangling\nor non-verbatim ref, are dropped."
          }
        }
      },
      "ExplainPatch": {
        "type": "object",
        "description": "Response of `POST /stages/explain`.",
        "required": [
          "explanation"
        ],
        "properties": {
          "explanation": {
            "$ref": "#/components/schemas/Explanation"
          }
        },
        "additionalProperties": false
      },
      "Explanation": {
        "type": "object",
        "required": [
          "summary",
          "reasons"
        ],
        "properties": {
          "summary": {
            "type": "string",
            "description": "Blanked when it contains a quotation that is not verbatim in the analysed material."
          },
          "reasons": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Reason"
            },
            "description": "Each reason must cite at least one existing evidence ID and quote only verbatim text\n(document, context items, evidence details), otherwise it is dropped. A quotation is a\npassage of 12 or more characters inside double quotes or guillemets."
          }
        }
      },
      "ExtractPatch": {
        "type": "object",
        "description": "Response of `POST /stages/extract`.",
        "required": [
          "document"
        ],
        "properties": {
          "document": {
            "$ref": "#/components/schemas/Document"
          },
          "language": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Language"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "FactCheck": {
        "type": "object",
        "description": "A published fact-check of a claim (`ClaimReview`, e.g. from the Google Fact Check Tools API).",
        "required": [
          "claim",
          "rating"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "description": "The claim that was reviewed, as stated by the fact-checker."
          },
          "rating": {
            "type": "string",
            "description": "Textual rating as published, e.g. `False`, `Misleading`, `Mostly true`."
          },
          "publisher": {
            "type": [
              "string",
              "null"
            ],
            "description": "Fact-checking organisation, e.g. `Pagella Politica`."
          }
        }
      },
      "Family": {
        "type": "string",
        "description": "Signal family; inside a family only the strongest signal counts (plan §5).",
        "enum": [
          "techniques",
          "tone",
          "claim_support",
          "fact_checks",
          "source_profile",
          "text_reuse",
          "timing",
          "infrastructure",
          "known_networks"
        ]
      },
      "Health": {
        "type": "object",
        "description": "Response of `GET /api/health`.",
        "required": [
          "status",
          "pipeline_version"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "`ok` when the API and its database work."
          },
          "pipeline_version": {
            "type": "string"
          },
          "worker": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/WorkerHealth",
                "description": "Null when the worker is unreachable."
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Input": {
        "type": "object",
        "required": [
          "kind",
          "value"
        ],
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/InputKind"
          },
          "value": {
            "type": "string",
            "description": "The pasted text, the article/image URL, or a `data:image/...;base64,...` payload."
          },
          "context_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional link to the comment, social post or article where the image/content was shared,\ngiving the pipeline outlet, timestamp, author and surrounding caption context."
          },
          "explanation_language": {
            "type": [
              "string",
              "null"
            ],
            "description": "Language the reader wants the explanation in (D14): ISO 639-1 code, e.g. `it`; null\nmeans English. The API lowercases it and drops a region (`pt-BR` → `pt`). Quotations\nstay in their original language."
          }
        }
      },
      "InputKind": {
        "type": "string",
        "enum": [
          "text",
          "url",
          "image"
        ]
      },
      "Language": {
        "type": "object",
        "required": [
          "code",
          "confidence",
          "support"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "ISO 639-1 code, e.g. `it`."
          },
          "confidence": {
            "type": "number",
            "format": "double",
            "description": "Detector confidence in `[0, 1]`."
          },
          "support": {
            "$ref": "#/components/schemas/LanguageSupport"
          }
        }
      },
      "LanguageSupport": {
        "type": "string",
        "description": "Support tiers shown to the user (D2).",
        "enum": [
          "evaluated",
          "supported",
          "unsupported"
        ]
      },
      "OutletType": {
        "type": "string",
        "enum": [
          "wire_service",
          "national",
          "local",
          "partisan",
          "state_affiliated",
          "fact_checker",
          "satire"
        ]
      },
      "Percentiles": {
        "type": "object",
        "description": "Nearest-rank percentiles in milliseconds.",
        "required": [
          "p50",
          "p95"
        ],
        "properties": {
          "p50": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "p95": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "Reason": {
        "type": "object",
        "required": [
          "text",
          "evidence_ids"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "RetrievePatch": {
        "type": "object",
        "description": "Response of `POST /stages/retrieve`.",
        "required": [
          "context",
          "sources"
        ],
        "properties": {
          "context": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContextItem"
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SourceProfile"
            },
            "description": "Profiles of the outlets seen in the document and the context, one per domain."
          },
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "Progress note, e.g. \"14 sources from 3 adapters\"."
          }
        },
        "additionalProperties": false
      },
      "Score": {
        "type": "object",
        "required": [
          "abstained",
          "breakdown"
        ],
        "properties": {
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "Calibrated confidence in `[0, 1]`; null when abstained."
          },
          "abstained": {
            "type": "boolean",
            "description": "True shows \"Not enough evidence\" instead of a score."
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why it abstained. Required when `abstained`."
          },
          "breakdown": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Contribution"
            },
            "description": "Contribution of each family, the weights shown to the user."
          }
        }
      },
      "ScorePatch": {
        "type": "object",
        "description": "Response of `POST /stages/score`.",
        "required": [
          "scores"
        ],
        "properties": {
          "scores": {
            "$ref": "#/components/schemas/Scores"
          }
        },
        "additionalProperties": false
      },
      "Scores": {
        "type": "object",
        "required": [
          "single",
          "coordinated"
        ],
        "properties": {
          "single": {
            "$ref": "#/components/schemas/Score"
          },
          "coordinated": {
            "$ref": "#/components/schemas/Score"
          }
        }
      },
      "SearchQuery": {
        "type": "object",
        "required": [
          "text",
          "language"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "language": {
            "type": "string",
            "description": "ISO 639-1 code of the query."
          }
        }
      },
      "SignalsPatch": {
        "type": "object",
        "description": "Response of `POST /stages/signals_single` and `POST /stages/signals_coordinated`.\n\nEvery evidence family must belong to the stage's dimension.",
        "required": [
          "evidence"
        ],
        "properties": {
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Evidence"
            }
          }
        },
        "additionalProperties": false
      },
      "SourceProfile": {
        "type": "object",
        "description": "Measurable facts about one outlet (D9: no political-bias ratings).",
        "required": [
          "domain"
        ],
        "properties": {
          "domain": {
            "type": "string",
            "description": "Outlet domain as written in `document.outlet` and `context[].outlet`; unique in `sources`."
          },
          "registered_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Domain registration date (RDAP)."
          },
          "first_cert_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Issue date of the first certificate in the Certificate Transparency logs."
          },
          "outlet_type": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/OutletType"
              },
              {
                "type": "null"
              }
            ]
          },
          "country": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 3166-1 alpha-2 country of the outlet, e.g. `IT`."
          },
          "known_network": {
            "type": [
              "string",
              "null"
            ],
            "description": "Documented network that lists the domain, e.g. `portal_kombat` (VIGINUM); null when\nit is on no list."
          }
        }
      },
      "SourceRef": {
        "oneOf": [
          {
            "type": "object",
            "title": "DocumentRef",
            "description": "A span of the analysed document.",
            "required": [
              "span",
              "kind"
            ],
            "properties": {
              "span": {
                "$ref": "#/components/schemas/Span"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "document"
                ]
              }
            }
          },
          {
            "type": "object",
            "title": "ContextRef",
            "description": "A retrieved context item, optionally with a quote that must appear verbatim in its text.",
            "required": [
              "id",
              "kind"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "quote": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "kind": {
                "type": "string",
                "enum": [
                  "context"
                ]
              }
            }
          },
          {
            "type": "object",
            "title": "UrlRef",
            "description": "An external source that is not a context item, e.g. a fact-check or RDAP record.",
            "required": [
              "url",
              "kind"
            ],
            "properties": {
              "url": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "url"
                ]
              }
            }
          }
        ]
      },
      "Span": {
        "type": "object",
        "description": "A verbatim slice of `document.paragraphs[paragraph]`.\n\nOffsets count Unicode code points (Python `str` indexing), `end` exclusive. JavaScript\nstrings index UTF-16 code units: slice with `Array.from(paragraph).slice(start, end)`,\notherwise spans after an emoji are off.",
        "required": [
          "paragraph",
          "start",
          "end"
        ],
        "properties": {
          "paragraph": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "start": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "StageAvailability": {
        "type": "object",
        "required": [
          "name",
          "implemented"
        ],
        "properties": {
          "name": {
            "$ref": "#/components/schemas/StageName"
          },
          "implemented": {
            "type": "boolean",
            "description": "False until the stage's owner ships its `run` function, or when it failed to load."
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why the stage failed to load (exception type); null when it loaded or is not shipped yet."
          }
        }
      },
      "StageName": {
        "type": "string",
        "description": "Pipeline stage. The worker serves each one at `POST /stages/{name}`.",
        "enum": [
          "extract",
          "understand",
          "retrieve",
          "story",
          "signals_single",
          "signals_coordinated",
          "score",
          "explain"
        ]
      },
      "StageStats": {
        "type": "object",
        "description": "Counts of one stage over the stored analyses. A re-run keeps the steps before its first\nstage, so those count once per record that carries them.",
        "required": [
          "name",
          "done",
          "failed",
          "skipped"
        ],
        "properties": {
          "name": {
            "$ref": "#/components/schemas/StageName"
          },
          "done": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "failed": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "skipped": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "duration_ms": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Percentiles",
                "description": "Duration of the `done` runs; null when there are none."
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Stats": {
        "type": "object",
        "description": "Response of `GET /api/stats`: usage and latency over every stored analysis.",
        "required": [
          "analyses",
          "submissions",
          "cache_hits",
          "stages"
        ],
        "properties": {
          "analyses": {
            "$ref": "#/components/schemas/StatusCounts"
          },
          "submissions": {
            "type": "integer",
            "format": "int64",
            "description": "Accepted `POST /api/analyses` requests, cache hits included.",
            "minimum": 0
          },
          "cache_hits": {
            "type": "integer",
            "format": "int64",
            "description": "Submissions answered with an earlier analysis of the same input.",
            "minimum": 0
          },
          "analysis_ms": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Percentiles",
                "description": "Wall time of `done` analyses from submission to result, queue wait included."
              },
              {
                "type": "null"
              }
            ]
          },
          "stages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StageStats"
            },
            "description": "One entry per stage, in execution order."
          }
        }
      },
      "StatusCounts": {
        "type": "object",
        "description": "Number of analyses per status.",
        "required": [
          "queued",
          "running",
          "done",
          "failed"
        ],
        "properties": {
          "queued": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "running": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "done": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "failed": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "Step": {
        "type": "object",
        "required": [
          "name",
          "state"
        ],
        "properties": {
          "name": {
            "$ref": "#/components/schemas/StageName"
          },
          "state": {
            "$ref": "#/components/schemas/StepState"
          },
          "duration_ms": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "Short progress note for the UI, e.g. \"14 sources\" or \"2 claims dropped: not verbatim\"."
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why the stage failed or was skipped."
          }
        }
      },
      "StepState": {
        "type": "string",
        "enum": [
          "pending",
          "running",
          "done",
          "skipped",
          "failed"
        ]
      },
      "StoryAssignment": {
        "type": "object",
        "required": [
          "context_id",
          "similarity",
          "in_story"
        ],
        "properties": {
          "context_id": {
            "type": "string"
          },
          "similarity": {
            "type": "number",
            "format": "double"
          },
          "in_story": {
            "type": "boolean"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "StoryPatch": {
        "type": "object",
        "description": "Response of `POST /stages/story`: story fields for existing context items.",
        "required": [
          "assignments"
        ],
        "properties": {
          "assignments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StoryAssignment"
            }
          }
        },
        "additionalProperties": false
      },
      "Topic": {
        "type": "object",
        "required": [
          "summary",
          "entities"
        ],
        "properties": {
          "summary": {
            "type": "string"
          },
          "entities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "date": {
            "type": [
              "string",
              "null"
            ],
            "description": "Event date as written or normalised (free text, e.g. `2026-11-12`)."
          },
          "place": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "UnderstandPatch": {
        "type": "object",
        "description": "Response of `POST /stages/understand`.",
        "required": [
          "topic",
          "claims",
          "queries"
        ],
        "properties": {
          "topic": {
            "$ref": "#/components/schemas/Topic"
          },
          "claims": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Claim"
            }
          },
          "queries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchQuery"
            }
          }
        },
        "additionalProperties": false
      },
      "WorkerHealth": {
        "type": "object",
        "description": "Response of the worker's `GET /health`.",
        "required": [
          "stages"
        ],
        "properties": {
          "stages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StageAvailability"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "analyses",
      "description": "Create and read analyses"
    },
    {
      "name": "ops",
      "description": "Health, usage and evaluation metrics"
    },
    {
      "name": "sources",
      "description": "What stored analyses show about the outlets"
    }
  ]
}
