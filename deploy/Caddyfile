# SITE_ADDRESS: the VPS hostname (e.g. srv123456.hstgr.cloud) for automatic HTTPS;
# defaults to plain HTTP on :80 for local runs. API_UPSTREAM defaults to the compose service.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Caddy overwrites X-Forwarded-For from untrusted clients with the real peer address,
	# which the API's rate limiter trusts (TRUST_PROXY=true). SSE is flushed immediately.
	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:8080}
	}

	# The web UI: the static build of web/ (`bun run build` -> web/dist), copied by the deploy
	# workflow to ./web next to compose.yaml and mounted at /srv. Unknown paths fall back to
	# index.html for client-side routes. Until a build is there, the root shows the API docs.
	handle {
		root * {$WEB_ROOT:/srv}
		@no_ui not file /index.html
		redir @no_ui /api/docs 302
		try_files {path} /index.html
		file_server
	}
}
