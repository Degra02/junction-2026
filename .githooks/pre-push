#!/bin/sh
# pre-push hook: abort the push if ruff reports errors.
#
# Enable once per clone (.git/hooks is not versioned, so every developer
# runs this on their own copy; `mise run setup` does it for you):
#
#     git config core.hooksPath .githooks
#
# Skip it once: git push --no-verify

if ! command -v uv >/dev/null 2>&1; then
	echo "pre-push: uv not found, skipping ruff check." >&2
	exit 0
fi

echo "pre-push: ruff check…"
if uvx ruff check .; then
	exit 0
fi

echo "" >&2
echo "pre-push: push aborted, ruff found errors." >&2
echo "          Many fix themselves with: uvx ruff check --fix ." >&2
echo "          To push anyway:           git push --no-verify" >&2
exit 1
