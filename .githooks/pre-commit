#!/bin/sh
# Enabled by `mise run setup` (core.hooksPath=.githooks).
set -eu

branch=$(git symbolic-ref --short -q HEAD || true)
if [ "$branch" = "main" ] && [ "${ALLOW_MAIN:-0}" != "1" ]; then
	echo "pre-commit: direct commits to main are blocked; work on a branch (ALLOW_MAIN=1 overrides)." >&2
	exit 1
fi

# The repo is published under MIT at submission: never let a key reach a commit.
exec mise exec -- gitleaks git --pre-commit --staged --redact --no-banner .
